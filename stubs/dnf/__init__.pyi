from collections.abc import Iterable, Iterator
from typing import overload

import hawkey
from dnf import conf as conf
from dnf import exceptions as exceptions
from dnf import rpm as rpm
from dnf import selector as selector

class Package:
    name: str
    version: str
    release: str
    epoch: int
    arch: str
    evr: str
    reponame: str
    location: str
    source_name: str | None
    sourcerpm: str
    chksum: tuple[int, bytes] | None
    requires: list[hawkey.Reldep]
    recommends: list[hawkey.Reldep]
    provides: list[hawkey.Reldep]
    files: list[str]
    def evr_cmp(self, other: Package) -> int: ...
    def remote_location(self, schemes: tuple[str, ...] | list[str] = ...) -> str | None: ...

class Query:
    def __iter__(self) -> Iterator[Package]: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def filter(self, *flags: int, **criteria: object) -> Query: ...
    def filterm(self, *flags: int, **criteria: object) -> Query: ...
    def available(self) -> Query: ...
    def installed(self) -> Query: ...
    def latest(self, limit: int = -1) -> Query: ...
    def run(self) -> list[Package]: ...

class Sack:
    def query(self, flags: int = 0) -> Query: ...
    def add_excludes(self, packages: Iterable[Package]) -> None: ...
    def remove_excludes(self, packages: Iterable[Package]) -> None: ...

class LibdnfRepo:
    def getRevision(self) -> int: ...
    def getMaxTimestamp(self) -> int: ...
    def expire(self) -> None: ...

class Repo:
    id: str
    _repo: LibdnfRepo
    def disable(self) -> None: ...
    def remote_location(self, location: str, schemes: tuple[str, ...] = ...) -> str | None: ...

class RepoDict:
    def add_new_repo(
        self,
        repoid: str,
        conf: conf.Conf,
        baseurl: tuple[str, ...] | list[str] = (),
        **kwargs: str | int | list[str],
    ) -> Repo: ...
    def items(self) -> Iterator[tuple[str, Repo]]: ...
    def iter_enabled(self) -> Iterator[Repo]: ...

class Option:
    def getPriority(self) -> int: ...
    # SWIG exposes two overloads: positional (priority, value) for all Option
    # subclasses, and keyword (value=, priority=) for scalar options
    @overload
    def set(self, priority: int, value: str | list[str]) -> None: ...
    @overload
    def set(self, value: str, priority: int) -> None: ...

class StringList:
    def push_back(self, value: str) -> None: ...

class StringListOption(Option):
    def getValue(self) -> StringList: ...

class ConfigMain:
    def config_file_path(self) -> Option: ...
    def reposdir(self) -> Option: ...
    def persistdir(self) -> Option: ...
    def system_cachedir(self) -> Option: ...
    def cachedir(self) -> Option: ...
    def logdir(self) -> Option: ...
    def varsdir(self) -> Option: ...
    def optional_metadata_types(self) -> StringListOption: ...

class Goal:
    def install(self, select: selector.Selector, *, optional: bool = False) -> None: ...

class Transaction:
    install_set: set[Package]

class Base:
    conf: conf.Conf
    sack: Sack
    repos: RepoDict
    transaction: Transaction
    _goal: Goal
    def __init__(self, conf: conf.Conf | None = None) -> None: ...
    def read_all_repos(self) -> None: ...
    def fill_sack(self, load_system_repo: bool = True, load_available_repos: bool = True) -> None: ...
    def add_remote_rpms(self, path_list: list[str], strict: bool = True, progress: object = None) -> list[Package]: ...
    def reset(self, sack: bool = False, repos: bool = False, goal: bool = False) -> None: ...
    def install(self, pkg_spec: str) -> int: ...
    def package_install(self, pkg: Package, strict: bool = True) -> int: ...
    def resolve(self, allow_erasing: bool = False) -> bool: ...
    def download_packages(self, pkglist: Iterable[Package], progress: object = None) -> None: ...
