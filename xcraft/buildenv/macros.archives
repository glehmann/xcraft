# the static archives of the build root made deterministic, see archives.py: after brp-strip-static-archive, which
# writes them again with the time of the build, at the end of %__spec_install_post, as specs replace %__os_install_post
%__spec_install_post\
    %{?__debug_package:%{__debug_install_post}}\
    %{__arch_install_post}\
    %{__os_install_post}\
    /usr/bin/python3 -I /xcraft/archives.py "$RPM_BUILD_ROOT"\
%{nil}
