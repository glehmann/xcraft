Change the build configuration to decrease size and attack area

This is made up of:
* Removing support for various block device formats.
* Removing support for VFIO.
* Enable NVME for guest UEFI
* List of devices needed so ./configure option
  --without-default-devices can be used.

diff --git a/block/meson.build b/block/meson.build
index 34b1b2a30630..6c0eb34f3834 100644
--- a/block/meson.build
+++ b/block/meson.build
@@ -50,17 +50,17 @@ endif
 if get_option('vdi').allowed()
   block_ss.add(files('vdi.c'))
 endif
-if get_option('vhdx').allowed()
+if get_option('vhdx').allowed() and not xen.found()
   block_ss.add(files(
     'vhdx-endian.c',
     'vhdx-log.c',
     'vhdx.c'
   ))
 endif
-if get_option('vmdk').allowed()
+if get_option('vmdk').allowed() and not xen.found()
   block_ss.add(files('vmdk.c'))
 endif
-if get_option('vpc').allowed()
+if get_option('vpc').allowed() and not xen.found()
   block_ss.add(files('vpc.c'))
 endif
 if get_option('cloop').allowed()
