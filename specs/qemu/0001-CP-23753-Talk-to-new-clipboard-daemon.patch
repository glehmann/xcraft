From bd478cbdd904bbb3d6d63add81d9138b0bad266b Mon Sep 17 00:00:00 2001
From: Liang Dai <liang.dai1@citrix.com>
Date: Wed, 16 Aug 2017 22:00:37 +0800
Subject: [PATCH] CP-23753: Talk to new clipboard daemon

Signed-off-by: Liang Dai <liang.dai1@citrix.com>
diff --git a/qemu-options.hx b/qemu-options.hx
index ab23f14d21..f5c475f6c7 100644
--- a/qemu-options.hx
+++ b/qemu-options.hx
@@ -2653,6 +2653,9 @@ ARCHHEADING(, QEMU_ARCH_I386)
 
 ARCHHEADING(i386 target only:, QEMU_ARCH_I386)
 
+DEF("vnc-clipboard-socket-fd", HAS_ARG, QEMU_OPTION_vnc_clipboard_socket_fd,
+    "-vnc-clipboard-socket-fd fd   file descriptor for unix domain socket connected to xs-clipbpard/xcp-clipboardd (Xen only)\n", QEMU_ARCH_ALL)
+
 DEF("win2k-hack", 0, QEMU_OPTION_win2k_hack,
     "-win2k-hack     use it when installing Windows 2000 to avoid a disk full bug\n",
     QEMU_ARCH_I386)
diff --git a/system/vl.c b/system/vl.c
index 3b7057e6c6..e23459268f 100644
--- a/system/vl.c
+++ b/system/vl.c
@@ -141,6 +141,7 @@
 #include "system/iothread.h"
 #include "qemu/guest-random.h"
 #include "qemu/keyval.h"
