 #define MAX_VIRTIO_CONSOLES 1
 
@@ -3464,6 +3465,14 @@ void qemu_init(int argc, char **argv)
                 vnc_parse(optarg);
                 display_remote++;
                 break;
+            case QEMU_OPTION_vnc_clipboard_socket_fd:
+                if (!sscanf(optarg, "%d", &xen_clipboardd_fd) ||
+                    xen_clipboardd_fd < 0)
+                {
+                    error_report("invalid argument");
+                    exit(1);
+                }
+                break;
 #endif
             case QEMU_OPTION_no_reboot:
                 olist = qemu_find_opts("action");
